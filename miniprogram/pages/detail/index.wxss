.detail-page {
  min-height: 100vh;
  background:
    radial-gradient(80% 34% at 100% -4%, rgba(217, 180, 91, 0.14), rgba(217, 180, 91, 0) 62%),
    radial-gradient(60% 30% at 0% 6%, rgba(166, 64, 47, 0.12), rgba(166, 64, 47, 0) 64%),
    #17120d;
}

.detail-content {
  padding: 26rpx 30rpx 20rpx;
}

.detail-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border: 1rpx solid #b99a63;
  border-radius: 14rpx;
  background:
    radial-gradient(120% 80% at 0% 0%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 55%),
    linear-gradient(158deg, #f7ecd6 0%, #efdfc0 55%, #e7d2a9 100%);
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.42), inset 0 0 0 3rpx rgba(255, 255, 255, 0.24);
}

.detail-hero::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 4rpx;
  background: linear-gradient(90deg, rgba(166, 64, 47, 0), rgba(166, 64, 47, 0.42), rgba(217, 180, 91, 0.6), rgba(166, 64, 47, 0.42), rgba(166, 64, 47, 0));
}

.detail-hero::after {
  content: "";
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  width: 24rpx;
  height: 24rpx;
  border-right: 2rpx solid rgba(160, 120, 38, 0.45);
  border-bottom: 2rpx solid rgba(160, 120, 38, 0.45);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 12rpx;
  border: 1rpx solid rgba(90, 66, 37, 0.16);
  border-radius: 4rpx;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.category-dot {
  width: 7rpx;
  height: 7rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.category-sep {
  margin: 0 5rpx;
  opacity: 0.6;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 14rpx;
  border: 1rpx solid currentColor;
  border-radius: 4rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.35);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  transform: rotate(-1.5deg);
}

.status-dot {
  width: 7rpx;
  height: 7rpx;
  margin-right: 7rpx;
  border-radius: 50%;
}

.task-title {
  margin-top: 24rpx;
  color: #2a1e12;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.32;
}

.task-subline {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  color: #8a6b3f;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.task-code {
  font-weight: 600;
}

.sub-dot {
  width: 6rpx;
  height: 6rpx;
  margin: 0 12rpx;
  border-radius: 50%;
  background: rgba(138, 107, 63, 0.6);
}

.project-line {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  color: #6f5736;
  font-size: 19rpx;
}

.project-line-label {
  margin-right: 8rpx;
  padding: 2rpx 8rpx;
  border: 1rpx dashed rgba(111, 87, 54, 0.45);
  border-radius: 4rpx;
  color: #8a6b3f;
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

.hero-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.priority-chip {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 12rpx;
  border: 1rpx solid currentColor;
  border-radius: 4rpx;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.priority-stars {
  margin-right: 8rpx;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.due-text {
  font-size: 20rpx;
  font-weight: 600;
}

.due-normal {
  color: #35675d;
}

.due-warning {
  color: #a17826;
}

.due-danger {
  color: #a6402f;
}

.due-muted {
  color: #8a7350;
}

.meta-card {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  padding: 22rpx 24rpx 6rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.3);
  border-radius: 12rpx;
  background: linear-gradient(158deg, #2c2418, #1f1811);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.03);
}

.meta-cell {
  width: 50%;
  margin-bottom: 18rpx;
}

.meta-label {
  display: block;
  color: #96805f;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.meta-value {
  display: block;
  margin-top: 5rpx;
  color: #f0e3c8;
  font-size: 24rpx;
  font-weight: 600;
}

.meta-value.small {
  font-size: 19rpx;
  font-weight: 400;
}

.meta-unit {
  color: #a08a66;
  font-size: 18rpx;
  font-weight: 400;
}

.section-card {
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid #b99a63;
  border-radius: 14rpx;
  background: linear-gradient(158deg, #f7ecd6 0%, #efdfc0 60%, #e7d2a9 100%);
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.38);
}

.card-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.card-title {
  color: #2a1e12;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.card-index {
  color: #a17826;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.description {
  display: block;
  margin-top: 14rpx;
  color: #5a4530;
  font-size: 24rpx;
  line-height: 1.85;
}

.assignee-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.3);
  border-radius: 12rpx;
  background: linear-gradient(158deg, #2c2418, #1f1811);
}

.assignee-main {
  display: flex;
  align-items: center;
}

.assignee-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid rgba(255, 248, 232, 0.4);
  border-radius: 50%;
  color: #fff8e8;
  font-size: 27rpx;
  font-weight: 700;
}

.assignee-copy {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.assignee-label {
  display: block;
  color: #96805f;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.assignee-name {
  display: block;
  margin-top: 2rpx;
  color: #f0e3c8;
  font-size: 25rpx;
  font-weight: 600;
}

.assignee-title {
  display: block;
  margin-top: 2rpx;
  color: #a08a66;
  font-size: 18rpx;
}

.assignee-state {
  flex: none;
  margin-left: 12rpx;
  padding: 5rpx 12rpx;
  border: 1rpx solid currentColor;
  border-radius: 4rpx;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.assignee-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(217, 180, 91, 0.16);
  color: #8f7b5c;
  font-size: 18rpx;
}

.review-note-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #c58b74;
  border-radius: 12rpx;
  background: linear-gradient(158deg, #f6e3d7, #ecd0bf);
  box-shadow: 0 12rpx 26rpx rgba(0, 0, 0, 0.3);
}

.review-note-head {
  display: flex;
  align-items: center;
  color: #a6402f;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.review-note-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #a6402f;
  color: #f6e3d7;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 18rpx;
}

.review-note-text {
  display: block;
  margin-top: 12rpx;
  color: #5a2f24;
  font-size: 23rpx;
  line-height: 1.75;
}

.review-panel {
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid #b99a63;
  border-radius: 14rpx;
  background: linear-gradient(158deg, #f7ecd6, #e9d5ae);
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.38);
}

.review-input {
  width: 100%;
  height: 180rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(111, 87, 54, 0.32);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.4);
  color: #2c2216;
  font-size: 23rpx;
  line-height: 1.65;
}

.review-placeholder {
  color: #a18a66;
}

.review-counter {
  display: block;
  margin-top: 8rpx;
  color: #8a7350;
  font-size: 18rpx;
  text-align: right;
}

.admin-action-card {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(192, 113, 99, 0.4);
  border-radius: 10rpx;
  background: rgba(166, 64, 47, 0.12);
}

.admin-action-copy {
  display: flex;
  flex-direction: column;
}

.admin-action-title {
  color: #e0a094;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.admin-action-desc {
  margin-top: 4rpx;
  color: #a08a66;
  font-size: 18rpx;
  line-height: 1.6;
}

.cancel-task-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 70rpx;
  margin-top: 16rpx;
  border: 1rpx solid rgba(192, 113, 99, 0.6);
  border-radius: 8rpx;
  background: rgba(166, 64, 47, 0.2);
  color: #e0a094;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1;
}

.cancel-task-hover {
  background: rgba(166, 64, 47, 0.3);
}

.timeline-card {
  margin-top: 24rpx;
  padding: 26rpx 28rpx 8rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.3);
  border-radius: 12rpx;
  background: linear-gradient(158deg, #2c2418, #1f1811);
}

.timeline {
  margin-top: 18rpx;
}

.timeline-card .card-title {
  color: #f0e3c8;
}

.timeline-card .card-index {
  color: #c9a45c;
}

.timeline-item {
  display: flex;
}

.timeline-rail {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  width: 28rpx;
}

.timeline-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 5rpx;
  border: 2rpx solid #1f1811;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx rgba(217, 180, 91, 0.35);
}

.timeline-line {
  flex: 1;
  width: 2rpx;
  min-height: 28rpx;
  margin: 6rpx 0;
  background: linear-gradient(180deg, rgba(217, 180, 91, 0.4), rgba(217, 180, 91, 0.06));
}

.timeline-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 22rpx;
  padding-left: 14rpx;
}

.timeline-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.timeline-actor {
  color: #e2c37d;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.timeline-time {
  flex: none;
  margin-left: 10rpx;
  color: #8f7b5c;
  font-size: 17rpx;
}

.timeline-text {
  display: block;
  margin-top: 4rpx;
  color: #c9b58c;
  font-size: 21rpx;
  line-height: 1.65;
}

.detail-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 36rpx 0 24rpx;
  color: #6f5f47;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.foot-line {
  width: 46rpx;
  height: 1rpx;
  margin: 0 12rpx;
  background: linear-gradient(90deg, rgba(217, 180, 91, 0), rgba(217, 180, 91, 0.4));
}

.foot-line:last-child {
  background: linear-gradient(90deg, rgba(217, 180, 91, 0.4), rgba(217, 180, 91, 0));
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  border-top: 1rpx solid rgba(217, 180, 91, 0.26);
  background: rgba(23, 18, 13, 0.97);
}

.action-inner {
  display: flex;
  align-items: center;
  padding: 18rpx 30rpx 0;
}

.action-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 2;
  height: 84rpx;
  border: 1rpx solid #f0d399;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #e8c378, #c79a43);
  box-shadow: 0 5rpx 0 #7d5a22;
  color: #241a0f;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1;
}

.action-primary-hover {
  opacity: 0.9;
  transform: translateY(2rpx);
  box-shadow: 0 3rpx 0 #7d5a22;
}

.action-approve {
  border-color: #a9c39a;
  background: linear-gradient(135deg, #6f8f6a, #3f5d4a);
  box-shadow: 0 5rpx 0 #24382b;
  color: #f0f5e8;
}

.action-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 84rpx;
  margin-right: 16rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.55);
  border-radius: 8rpx;
  background: transparent;
  color: #e2c37d;
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1;
}

.action-secondary-hover {
  background: rgba(217, 180, 91, 0.12);
}

.detail-loading {
  padding: 30rpx;
}

.loading-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.12);
  border-radius: 14rpx;
  background: linear-gradient(100deg, #241c15 0%, #2f2419 42%, #241c15 82%);
  background-size: 220% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.loading-card.small {
  padding: 20rpx 28rpx;
}

.loading-line {
  height: 20rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: rgba(217, 180, 91, 0.1);
}

.loading-chip {
  width: 100rpx;
  height: 36rpx;
  margin-top: 0;
  border-radius: 4rpx;
}

.loading-title {
  width: 70%;
  height: 38rpx;
  margin-top: 22rpx;
}

.loading-wide {
  width: 92%;
}

.loading-mid {
  width: 64%;
}

.detail-error {
  padding-top: 20rpx;
}

.rise-in {
  animation: rise-in 440ms cubic-bezier(0.22, 0.8, 0.3, 1) both;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes shimmer {
  0% {
    background-position: 120% 0;
  }
  100% {
    background-position: -120% 0;
  }
}

@media (max-width: 350px) {
  .task-title {
    font-size: 40rpx;
  }

  .meta-value.small {
    font-size: 17rpx;
  }

  .action-secondary {
    font-size: 23rpx;
  }
}
