.projects-page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background:
    radial-gradient(80% 34% at 100% -4%, rgba(217, 180, 91, 0.14), rgba(217, 180, 91, 0) 62%),
    radial-gradient(60% 30% at 0% 8%, rgba(166, 64, 47, 0.12), rgba(166, 64, 47, 0) 64%),
    #17120d;
}

.projects-content {
  padding: 26rpx 30rpx 20rpx;
}

.intro {
  padding: 8rpx 4rpx 0;
}

.intro-title {
  margin-top: 12rpx;
  color: #f4e8d2;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.35;
}

.intro-sub {
  display: block;
  margin-top: 14rpx;
  color: #a08a66;
  font-size: 22rpx;
  line-height: 1.75;
}

.create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  border: 1rpx solid #f0d399;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #e8c378, #c79a43);
  box-shadow: 0 6rpx 0 #7d5a22, 0 14rpx 26rpx rgba(0, 0, 0, 0.35);
  color: #241a0f;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  line-height: 1;
}

.create-btn-hover {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 0 #7d5a22;
}

.archive-entry {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.28);
  border-radius: 10rpx;
  background: linear-gradient(158deg, rgba(44, 36, 24, 0.9), rgba(31, 24, 17, 0.9));
}

.archive-entry-hover {
  opacity: 0.84;
}

.archive-entry-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.42);
  border-radius: 50%;
  color: #d9b45b;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 22rpx;
  font-weight: 700;
}

.archive-entry-copy {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.archive-entry-title {
  color: #f0e3c8;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.archive-entry-sub {
  margin-top: 2rpx;
  color: #8f7b5c;
  font-size: 16rpx;
  line-height: 1.45;
}

.archive-entry-count {
  flex: none;
  margin-left: 10rpx;
  color: #e2c37d;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 28rpx;
  font-weight: 700;
}

.chevron {
  width: 14rpx;
  height: 14rpx;
  margin-left: 12rpx;
  border-right: 2rpx solid #8f7b5c;
  border-top: 2rpx solid #8f7b5c;
  transform: rotate(45deg);
}

.section-head {
  margin-top: 40rpx;
}

.section-heading {
  position: relative;
  padding-left: 18rpx;
}

.section-heading::before {
  content: "";
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 0;
  width: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #e8c378, #a17826);
}

.section-title {
  display: block;
  color: #f4e8d2;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 33rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.section-sub {
  display: block;
  margin-top: 4rpx;
  color: #8f7b5c;
  font-size: 19rpx;
}

.loading-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.12);
  border-radius: 12rpx;
  background: linear-gradient(100deg, #241c15 0%, #2f2419 42%, #241c15 82%);
  background-size: 220% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.loading-line {
  height: 24rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: rgba(217, 180, 91, 0.1);
}

.loading-wide {
  width: 70%;
}

.loading-mid {
  width: 45%;
}

.project-list {
  margin-top: 20rpx;
}

.project-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid #b99a63;
  border-radius: 12rpx;
  background:
    radial-gradient(120% 90% at 0% 0%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 55%),
    linear-gradient(158deg, #f7ecd6 0%, #efdfc0 55%, #e7d2a9 100%);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.4);
}

.project-card::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 4rpx;
  background: linear-gradient(90deg, rgba(166, 64, 47, 0), rgba(217, 180, 91, 0.6), rgba(166, 64, 47, 0));
}

.project-card-hover {
  transform: translateY(2rpx);
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.36);
}

.project-card-archived {
  opacity: 0.86;
}

.project-status-archived {
  border-color: #8a7350;
  color: #8a7350;
}

.project-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.project-code {
  color: #8a6b3f;
  font-size: 17rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.project-status {
  padding: 3rpx 10rpx;
  border: 1rpx solid #35675d;
  border-radius: 4rpx;
  color: #35675d;
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

.project-name {
  display: block;
  margin-top: 10rpx;
  color: #2a1e12;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.project-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  color: #6f5736;
  font-size: 19rpx;
}

.meta-dot {
  width: 5rpx;
  height: 5rpx;
  margin: 0 10rpx;
  border-radius: 50%;
  background: rgba(111, 87, 54, 0.5);
}

.project-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(111, 87, 54, 0.22);
}

.project-created {
  color: #8a7350;
  font-size: 17rpx;
}

.project-enter {
  display: flex;
  align-items: center;
  color: #a17826;
  font-size: 20rpx;
  font-weight: 600;
}

.arrow {
  width: 12rpx;
  height: 12rpx;
  margin-left: 8rpx;
  border-right: 2rpx solid #a17826;
  border-top: 2rpx solid #a17826;
  transform: rotate(45deg);
}

.project-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.4);
  border-radius: 10rpx;
  color: #c9a45c;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 30rpx;
}

.empty-title {
  margin-top: 18rpx;
  color: #f4e8d2;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-desc {
  max-width: 500rpx;
  margin-top: 10rpx;
  color: #8f7b5c;
  font-size: 21rpx;
  line-height: 1.7;
  text-align: center;
}

@keyframes shimmer {
  0% {
    background-position: 120% 0;
  }
  100% {
    background-position: -120% 0;
  }
}

.rise-in {
  animation: rise-in 440ms cubic-bezier(0.22, 0.8, 0.3, 1) both;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
