.profile-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(80% 32% at 100% -4%, rgba(217, 180, 91, 0.14), rgba(217, 180, 91, 0) 62%),
    radial-gradient(60% 28% at 0% 8%, rgba(106, 83, 127, 0.14), rgba(106, 83, 127, 0) 64%),
    #17120d;
}

.profile-content {
  padding: 26rpx 30rpx 20rpx;
}

.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border: 1rpx solid #b99a63;
  border-radius: 14rpx;
  background:
    radial-gradient(120% 80% at 100% 0%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 55%),
    linear-gradient(158deg, #f7ecd6 0%, #efdfc0 55%, #e7d2a9 100%);
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.42), inset 0 0 0 3rpx rgba(255, 255, 255, 0.24);
}

.profile-hero::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 4rpx;
  background: linear-gradient(90deg, rgba(166, 64, 47, 0), rgba(217, 180, 91, 0.6), rgba(166, 64, 47, 0));
}

.hero-ring {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.ring-a {
  top: -140rpx;
  right: -110rpx;
  width: 340rpx;
  height: 340rpx;
  border: 1rpx solid rgba(160, 120, 38, 0.22);
}

.ring-b {
  top: -70rpx;
  right: -40rpx;
  width: 190rpx;
  height: 190rpx;
  border: 1rpx solid rgba(166, 64, 47, 0.2);
}

.hero-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 110rpx;
  height: 110rpx;
  border: 3rpx solid #f3e3c0;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx #a17826, 0 10rpx 24rpx rgba(71, 59, 45, 0.3);
  color: #fff8e8;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 42rpx;
  font-weight: 700;
}

.hero-identity {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.name-row {
  display: flex;
  align-items: center;
}

.profile-name {
  overflow: hidden;
  color: #2a1e12;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-badge {
  flex: none;
  margin-left: 12rpx;
  padding: 3rpx 10rpx;
  border: 1rpx solid #a6402f;
  border-radius: 4rpx;
  color: #a6402f;
  font-size: 17rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.profile-role {
  display: block;
  margin-top: 4rpx;
  color: #6f5736;
  font-size: 21rpx;
}

.profile-project {
  display: block;
  margin-top: 4rpx;
  color: #8a7350;
  font-size: 18rpx;
  letter-spacing: 0.5rpx;
}

.profile-qq {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.qq-label {
  padding: 2rpx 8rpx;
  border: 1rpx solid rgba(111, 87, 54, 0.4);
  border-radius: 4rpx;
  color: #8a6b3f;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.qq-value {
  margin-left: 8rpx;
  color: #6f5736;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.my-work-card {
  margin-top: 24rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.3);
  border-radius: 12rpx;
  background: linear-gradient(158deg, #2c2418, #1f1811);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.03);
}

.my-work-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
}

.my-work-head-hover {
  background: rgba(217, 180, 91, 0.06);
}

.my-work-copy {
  min-width: 0;
}

.my-work-title {
  display: block;
  color: #f0e3c8;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.my-work-sub {
  display: block;
  margin-top: 3rpx;
  color: #8f7b5c;
  font-size: 18rpx;
}

.work-list {
  padding: 0 24rpx 20rpx;
}

.work-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.2);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.035);
}

.work-item-hover {
  background: rgba(217, 180, 91, 0.1);
}

.work-main {
  flex: 1;
  min-width: 0;
}

.work-title {
  display: block;
  overflow: hidden;
  color: #f0e3c8;
  font-size: 22rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-meta {
  display: block;
  margin-top: 3rpx;
  color: #8f7b5c;
  font-size: 17rpx;
}

.work-status {
  flex: none;
  margin-left: 12rpx;
  padding: 3rpx 9rpx;
  border: 1rpx solid currentColor;
  border-radius: 4rpx;
  font-size: 16rpx;
  letter-spacing: 0.5rpx;
}

.work-empty {
  padding: 18rpx 4rpx 4rpx;
  color: #8f7b5c;
  font-size: 19rpx;
  text-align: center;
}

.hero-divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: linear-gradient(90deg, rgba(111, 87, 54, 0), rgba(111, 87, 54, 0.35), rgba(111, 87, 54, 0));
}

.profile-stats {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.profile-stat {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.profile-stat-number {
  color: #a17826;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.15;
}

.profile-stat-label {
  margin-top: 4rpx;
  color: #8a7350;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.score-strip {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(161, 120, 38, 0.4);
  border-radius: 8rpx;
  background: rgba(217, 180, 91, 0.14);
}

.score-copy {
  min-width: 0;
}

.score-label {
  display: block;
  color: #6f5736;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.score-note {
  display: block;
  margin-top: 2rpx;
  color: #8a7350;
  font-size: 17rpx;
}

.score-value {
  display: flex;
  align-items: baseline;
  flex: none;
  margin-left: 14rpx;
}

.score-number {
  color: #a17826;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.score-unit {
  margin-left: 4rpx;
  color: #8a7350;
  font-size: 17rpx;
}

.admin-strip {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(53, 103, 93, 0.35);
  border-radius: 8rpx;
  background: rgba(53, 103, 93, 0.12);
}

.admin-strip-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid rgba(53, 103, 93, 0.5);
  border-radius: 50%;
  color: #35675d;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 22rpx;
  font-weight: 700;
}

.admin-strip-copy {
  min-width: 0;
  margin-left: 12rpx;
}

.admin-strip-title {
  display: block;
  color: #2c4f47;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.admin-strip-sub {
  display: block;
  margin-top: 2rpx;
  color: #5a756c;
  font-size: 17rpx;
  line-height: 1.5;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 36rpx;
}

.section-heading {
  position: relative;
  padding-left: 18rpx;
}

.section-heading::before {
  content: "";
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 0;
  width: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #e8c378, #a17826);
}

.section-title {
  display: block;
  color: #f4e8d2;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 33rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.section-sub {
  display: block;
  margin-top: 4rpx;
  color: #8f7b5c;
  font-size: 19rpx;
}

.section-note {
  flex: none;
  color: #7d6b52;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.settings-head {
  margin-top: 40rpx;
}

.team-card {
  margin-top: 18rpx;
  padding: 4rpx 24rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.28);
  border-radius: 12rpx;
  background: linear-gradient(158deg, #2c2418, #1f1811);
}

.team-block {
  border-bottom: 1rpx solid rgba(217, 180, 91, 0.12);
}

.team-block:last-child {
  border-bottom: 0;
}

.team-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.team-row-hover {
  background: rgba(217, 180, 91, 0.05);
}

.member-detail {
  padding: 0 0 20rpx;
}

.member-qq {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx;
  border: 1rpx dashed rgba(217, 180, 91, 0.32);
  border-radius: 6rpx;
  background: rgba(217, 180, 91, 0.06);
}

.member-qq-label {
  padding: 2rpx 8rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.45);
  border-radius: 4rpx;
  color: #c9a45c;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.member-qq-value {
  margin-left: 10rpx;
  color: #f0e3c8;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.member-state {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid currentColor;
  border-radius: 999rpx;
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

.member-state-ok {
  color: #b8cfa8;
}

.member-state-off {
  color: #e0a094;
}

.member-actions {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.member-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 64rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.4);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.2);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.member-action:last-child {
  margin-left: 12rpx;
}

.member-action-warn {
  border-color: rgba(192, 113, 99, 0.5);
  color: #e0a094;
}

.member-action-ok {
  border-color: rgba(127, 156, 114, 0.5);
  color: #b8cfa8;
}

.member-action-danger {
  border-color: rgba(166, 64, 47, 0.55);
  background: rgba(166, 64, 47, 0.16);
  color: #e0a094;
}

.member-action-hover {
  opacity: 0.78;
}

.member-work-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 14rpx;
}

.member-work-title {
  color: #e2c37d;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.member-work-sub {
  color: #8f7b5c;
  font-size: 17rpx;
}

.team-row .chevron {
  flex: none;
  margin-left: 14rpx;
}

.team-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 58rpx;
  height: 58rpx;
  border: 1rpx solid rgba(255, 248, 232, 0.35);
  border-radius: 50%;
  color: #fff8e8;
  font-size: 22rpx;
  font-weight: 700;
}

.team-copy {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.team-name {
  display: block;
  overflow: hidden;
  color: #f0e3c8;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-role {
  display: block;
  margin-top: 2rpx;
  color: #8f7b5c;
  font-size: 18rpx;
}

.team-load {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 12rpx;
}

.load-pill {
  display: flex;
  align-items: center;
  padding: 3rpx 10rpx;
  border: 1rpx solid rgba(127, 156, 114, 0.4);
  border-radius: 999rpx;
  color: #b8cfa8;
  font-size: 16rpx;
}

.load-dot {
  width: 6rpx;
  height: 6rpx;
  margin-right: 6rpx;
  border-radius: 50%;
  background: #7f9c72;
}

.done-text {
  margin-top: 4rpx;
  color: #8f7b5c;
  font-size: 16rpx;
}

.settings-card {
  position: relative;
  z-index: 2;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.28);
  border-radius: 12rpx;
  background: linear-gradient(158deg, #2c2418, #1f1811);
}

.setting-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.setting-row-hover {
  opacity: 0.82;
}

.setting-divider {
  height: 1rpx;
  background: linear-gradient(90deg, rgba(217, 180, 91, 0), rgba(217, 180, 91, 0.16), rgba(217, 180, 91, 0));
}

.setting-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 54rpx;
  height: 54rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.4);
  border-radius: 50%;
  color: #d9b45b;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 22rpx;
  font-weight: 700;
}

.icon-switch {
  color: #d9b45b;
}

.icon-reset {
  border-color: rgba(192, 113, 99, 0.45);
  color: #e0a094;
}

.icon-data {
  border-color: rgba(127, 156, 114, 0.45);
  color: #b8cfa8;
}

.icon-about {
  border-color: rgba(168, 143, 196, 0.45);
  color: #c3b0d8;
}

.icon-project {
  border-color: rgba(217, 180, 91, 0.5);
  color: #e2c37d;
}

.setting-copy {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.setting-title {
  display: block;
  color: #f0e3c8;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.setting-desc {
  display: block;
  margin-top: 3rpx;
  color: #8f7b5c;
  font-size: 18rpx;
}

.chevron {
  width: 14rpx;
  height: 14rpx;
  margin-left: 12rpx;
  border-right: 2rpx solid #8f7b5c;
  border-top: 2rpx solid #8f7b5c;
  transform: rotate(45deg);
}

.chevron-open {
  transform: rotate(-45deg);
}

.profile-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 48rpx;
  padding-bottom: 24rpx;
}

.footer-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.4);
  border-radius: 8rpx;
  color: #c9a45c;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 22rpx;
}

.footer-brand {
  margin-top: 12rpx;
  color: #8f7b5c;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.footer-version {
  margin-top: 4rpx;
  color: #5f5140;
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

.rise-in {
  animation: rise-in 440ms cubic-bezier(0.22, 0.8, 0.3, 1) both;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 350px) {
  .profile-name {
    font-size: 38rpx;
  }

  .section-note {
    display: none;
  }
}
