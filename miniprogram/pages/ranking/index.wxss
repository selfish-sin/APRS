.ranking-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background:
    radial-gradient(78% 30% at 100% 0%, rgba(217, 180, 91, 0.16), rgba(217, 180, 91, 0) 60%),
    radial-gradient(60% 26% at 0% 18%, rgba(166, 64, 47, 0.13), rgba(166, 64, 47, 0) 64%),
    #17120d;
}

.ranking-content {
  padding: 26rpx 30rpx 20rpx;
}

.ledger-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border: 1rpx solid #b99a63;
  border-radius: 14rpx;
  background:
    radial-gradient(120% 80% at 100% 0%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 55%),
    linear-gradient(158deg, #f7ecd6 0%, #efdfc0 55%, #e7d2a9 100%);
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.42), inset 0 0 0 3rpx rgba(255, 255, 255, 0.24);
}

.ledger-hero::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 4rpx;
  background: linear-gradient(90deg, rgba(166, 64, 47, 0), rgba(217, 180, 91, 0.6), rgba(166, 64, 47, 0));
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.ledger-title {
  margin-top: 4rpx;
  color: #352719;
  font-size: 45rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.ledger-sub {
  display: block;
  margin-top: 8rpx;
  color: #7c6748;
  font-size: 19rpx;
  line-height: 1.5;
}

.ledger-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 74rpx;
  height: 74rpx;
  margin-left: 14rpx;
  border: 2rpx solid #a6402f;
  border-radius: 50%;
  background: rgba(166, 64, 47, 0.1);
  color: #a6402f;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: inset 0 0 0 4rpx rgba(166, 64, 47, 0.1);
  transform: rotate(-6deg);
}

.ledger-total {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  margin-top: 18rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(121, 92, 48, 0.24);
}

.ledger-total-number {
  color: #2f2418;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -1rpx;
}

.ledger-total-copy {
  display: flex;
  flex-direction: column;
  margin-left: 14rpx;
  padding-bottom: 6rpx;
}

.ledger-total-unit {
  color: #a17826;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.ledger-total-label {
  color: #8b7452;
  font-size: 17rpx;
}

.ledger-stats {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.ledger-stat {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.ledger-stat-value {
  color: #3b2d1e;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.ledger-stat-label {
  margin-top: 2rpx;
  color: #8b7452;
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

.ledger-stat-line {
  width: 1rpx;
  height: 38rpx;
  margin: 0 18rpx;
  background: rgba(121, 92, 48, 0.2);
}

.ledger-tip {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(166, 64, 47, 0.18);
  border-radius: 8rpx;
  background: rgba(166, 64, 47, 0.06);
  color: #7e5c43;
  font-size: 17rpx;
  line-height: 1.5;
}

.tip-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  border: 1rpx solid rgba(166, 64, 47, 0.45);
  border-radius: 50%;
  color: #a6402f;
  font-size: 14rpx;
  font-weight: 700;
}

.my-rank-strip {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(53, 103, 93, 0.24);
  border-radius: 8rpx;
  background: rgba(53, 103, 93, 0.08);
  color: #566f5d;
  font-size: 18rpx;
}

.my-rank-value {
  margin-left: 8rpx;
  color: #35675d;
  font-weight: 700;
}

.my-rank-dot {
  margin: 0 8rpx;
  color: #8b7452;
}

.month-scroll {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.month-track {
  display: inline-flex;
  padding: 2rpx 2rpx 8rpx;
}

.month-chip {
  flex: none;
  margin-right: 10rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.28);
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.18);
  color: #a08a66;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.month-chip-hover {
  opacity: 0.78;
}

.month-chip-on {
  border-color: #d9b45b;
  background: rgba(217, 180, 91, 0.16);
  color: #f0dca8;
  font-weight: 600;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 30rpx;
}

.section-heading {
  display: flex;
  flex-direction: column;
}

.section-title {
  color: #f0e3c8;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.section-sub {
  margin-top: 3rpx;
  color: #8f7b5c;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.section-note {
  color: #8a7350;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.ranking-card {
  margin-top: 16rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.26);
  border-radius: 12rpx;
  background: linear-gradient(158deg, #2c2418, #1f1811);
}

.ranking-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 72rpx 0;
  color: #8f7b5c;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.loading-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #d9b45b;
  box-shadow: 0 0 12rpx rgba(217, 180, 91, 0.7);
}

.rank-block {
  border-bottom: 1rpx solid rgba(217, 180, 91, 0.12);
}

.rank-block:last-child {
  border-bottom: 0;
}

.rank-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.rank-row-hover {
  opacity: 0.82;
}

.rank-row-me {
  margin: 0 -22rpx;
  padding: 20rpx 22rpx;
  background: rgba(217, 180, 91, 0.07);
}

.rank-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 46rpx;
  height: 46rpx;
  margin-right: 12rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.24);
  border-radius: 50%;
  color: #8b7452;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 20rpx;
  font-weight: 700;
}

.rank-badge-gold {
  border-color: #e2c37d;
  background: linear-gradient(145deg, #f2d79a, #c9a45c);
  color: #3b2a13;
  box-shadow: 0 0 16rpx rgba(217, 180, 91, 0.35);
}

.rank-badge-silver {
  border-color: #c7c9c4;
  background: linear-gradient(145deg, #eef0eb, #a9ada5);
  color: #3d403a;
}

.rank-badge-bronze {
  border-color: #b98458;
  background: linear-gradient(145deg, #dcae82, #9a6238);
  color: #3a2414;
}

.rank-number {
  line-height: 1;
}

.rank-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 62rpx;
  height: 62rpx;
  margin-right: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  color: #fff8e8;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 25rpx;
  font-weight: 700;
}

.rank-main {
  flex: 1;
  min-width: 0;
}

.rank-name-row {
  display: flex;
  align-items: center;
}

.rank-name {
  max-width: 180rpx;
  overflow: hidden;
  color: #f0e3c8;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 24rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-me-tag {
  flex: none;
  margin-left: 7rpx;
  padding: 1rpx 7rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.5);
  border-radius: 4rpx;
  color: #e2c37d;
  font-size: 14rpx;
}

.rank-removed-tag {
  flex: none;
  margin-left: 7rpx;
  padding: 1rpx 7rpx;
  border: 1rpx solid rgba(143, 123, 92, 0.45);
  border-radius: 4rpx;
  color: #8f7b5c;
  font-size: 14rpx;
}

.rank-title {
  display: block;
  margin-top: 1rpx;
  color: #8f7b5c;
  font-size: 16rpx;
}

.rank-workload {
  display: block;
  margin-top: 3rpx;
  overflow: hidden;
  color: #b9a37d;
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-meta {
  display: flex;
  align-items: center;
  margin-top: 3rpx;
  color: #6f604c;
  font-size: 15rpx;
}

.rank-meta-dot {
  margin: 0 6rpx;
}

.rank-side {
  display: flex;
  align-items: center;
  flex: none;
  margin-left: 12rpx;
}

.rank-amount {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.rank-amount-number {
  color: #e2c37d;
  font-family: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.1;
}

.rank-amount-unit {
  color: #8a7350;
  font-size: 14rpx;
  letter-spacing: 1rpx;
}

.chevron {
  width: 14rpx;
  height: 14rpx;
  margin-left: 12rpx;
  border-right: 2rpx solid #8f7b5c;
  border-top: 2rpx solid #8f7b5c;
  transform: rotate(45deg);
}

.chevron-open {
  transform: rotate(-45deg);
}

.rank-detail {
  margin: 0 0 18rpx 58rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.16);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.16);
}

.detail-block {
  display: flex;
  align-items: flex-start;
}

.detail-block + .detail-block {
  margin-top: 10rpx;
}

.detail-label {
  flex: none;
  width: 104rpx;
  padding-top: 4rpx;
  color: #8f7b5c;
  font-size: 15rpx;
  letter-spacing: 1rpx;
}

.detail-chips {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
}

.detail-chip {
  margin: 0 8rpx 6rpx 0;
  padding: 3rpx 10rpx;
  border: 1rpx solid rgba(217, 180, 91, 0.22);
  border-radius: 4rpx;
  color: #c9b184;
  font-size: 15rpx;
}

.detail-chip-stage {
  border-color: rgba(106, 83, 127, 0.35);
  color: #b6a3c8;
}

.ranking-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 42rpx;
  padding-bottom: 20rpx;
}

.footer-rule {
  width: 70rpx;
  height: 1rpx;
  margin-bottom: 14rpx;
  background: linear-gradient(90deg, rgba(217, 180, 91, 0), rgba(217, 180, 91, 0.55), rgba(217, 180, 91, 0));
}

.ranking-footer text {
  color: #6f604c;
  font-size: 16rpx;
  letter-spacing: 1rpx;
  text-align: center;
}

.footer-hint {
  margin-top: 4rpx;
  color: #574a39 !important;
  font-size: 14rpx !important;
}

@media (max-width: 350px) {
  .ledger-title {
    font-size: 39rpx;
  }

  .rank-meta {
    display: none;
  }
}

.rise-in {
  animation: rise-in 440ms cubic-bezier(0.22, 0.8, 0.3, 1) both;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
